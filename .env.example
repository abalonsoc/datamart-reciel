# Copien este archivo como .env y completen los valores. El .env NO se sube a GitHub.

# MySQL del Data Mart
DB_HOST=localhost
DB_PORT=3306
DB_USER=datamart
DB_PASSWORD=
DB_NAME=dm_comercial

# HubSpot (token de la Private App, empieza con pat-)
HUBSPOT_TOKEN=
# Opcional: nombre interno de la propiedad RUC de las empresas (si no se detecta sola)
HUBSPOT_PROP_RUC=

# Nubefact (panel de Nubefact > API - Integración: RUTA y TOKEN)
NUBEFACT_RUTA=
NUBEFACT_TOKEN=
NUBEFACT_SERIES=F001

# Archivos exportados (carpeta datos/, fuera de GitHub)
GOOGLE_ADS_CSV=datos/google_ads_campanas.csv
